      "boundElements": null,
      "updated": 1793817498450,
      "link": null,
      "locked": false,
      "text": "Code only (the LLM never touches it)\n\n• clones the repo safely\n• builds the base candidate plan\n• plants the fake secrets\n• runs every step in the sandbox\n• captures and decodes all traffic\n• sets the verdict\n• deletes the VM, counts the cost",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Code only (the LLM never touches it)\n\n• clones the repo safely\n• builds the base candidate plan\n• plants the fake secrets\n• runs every step in the sandbox\n• captures and decodes all traffic\n• sets the verdict\n• deletes the VM, counts the cost",
      "autoResize": true,
      "lineHeight": 1.25
    },
