      "boundElements": null,
      "updated": 1793817499232,
      "link": null,
      "locked": false,
      "text": "Timings (Bangalore, vc2-2c-4gb)\n• fresh VM reachable: 41–45 s\n• booting from a snapshot: 437 s (rejected)\n• paste → verdict with an armed VM: 112 s\n• one armed VM idle: ≈ $0.66 a day",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Timings (Bangalore, vc2-2c-4gb)\n• fresh VM reachable: 41–45 s\n• booting from a snapshot: 437 s (rejected)\n• paste → verdict with an armed VM: 112 s\n• one armed VM idle: ≈ $0.66 a day",
      "autoResize": true,
      "lineHeight": 1.25
    },
